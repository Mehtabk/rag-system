# Copy to .env and fill in. The default skeleton runs WITHOUT any of these
# (local/offline providers, dev-friendly security defaults). Set them to harden
# for staging/production. All app settings use the RAG_ prefix.

# --- Environment ---
RAG_ENV=local                 # local | staging | production
RAG_LOG_LEVEL=INFO

# --- API security ---
# Deny-by-default CORS. Comma-separate the origins you actually allow.
RAG_CORS_ORIGINS=
# Serve interactive docs (/docs). Set to false in production.
RAG_ENABLE_DOCS=true
# Reject questions longer than this many characters.
RAG_MAX_QUESTION_CHARS=2000
# Per-client rate limit: N requests per window (seconds).
RAG_RATE_LIMIT_REQUESTS=60
RAG_RATE_LIMIT_WINDOW_SECONDS=60
# Token required for privileged endpoints (/ingest). In production, if this is
# unset those endpoints are DISABLED (fail closed). Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_ADMIN_TOKEN=

# --- Provider credentials (only when using cloud providers) ---
RAG_OPENAI_API_KEY=
RAG_ANTHROPIC_API_KEY=
RAG_COHERE_API_KEY=
RAG_PINECONE_API_KEY=
